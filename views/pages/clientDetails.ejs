<a class="back-link" href="/clients">← Back to client directory</a>
<section class="page-heading"><p class="eyebrow">CLIENT PROFILE · <%= client.id %></p><div class="d-flex gap-3 align-items-center flex-wrap"><h1><%= client.name %></h1><%- include('../partials/riskBadge', { risk: client.riskCategory }) %></div><p class="lead"><%= client.classification %> client · <%= client.status %></p></section>
<div class="row g-4">
<div class="col-lg-7"><section class="surface p-4 mb-4"><h2>Client information</h2><dl class="details-grid"><dt>Email</dt><dd><%= client.email %></dd><dt>Phone</dt><dd><%= client.phone %></dd><dt>Classification</dt><dd><%= client.classification %></dd><dt>Assigned advisor</dt><dd><%= client.advisor %></dd><dt>Portfolio value</dt><dd><%= money(client.portfolioValue) %> CAD</dd></dl></section><section class="surface p-4"><h2>Advisory objectives</h2><p class="mb-0"><%= client.objective %></p></section></div>
<div class="col-lg-5"><section class="surface p-4 mb-4"><p class="eyebrow">REQUIRED REVIEW SECTION</p><h2>Compliance &amp; risk</h2><dl class="details-grid"><dt>Risk category</dt><dd><%- include('../partials/riskBadge', { risk: client.riskCategory }) %></dd><dt>KYC status</dt><dd><span class="status-label <%= client.kycComplete ? 'complete' : 'pending' %>"><%= client.kycComplete ? 'Complete' : 'Review pending' %></span></dd><dt>Last review</dt><dd><%= client.lastReview %></dd><dt>Next review</dt><dd><%= client.nextReview %></dd></dl></section><section class="surface p-4"><h2>Operations notes</h2><p class="mb-0"><%= client.notes %></p></section></div>
</div>
<p class="data-note">Current dataset values are shown above. Refresh this page after a saved dataset update.</p>
